# Copy to .env and change every value. .env is git-ignored. NEVER commit it.
DB_USERNAME=foodhub
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Demo accounts created on startup ONLY when a password is set. Leave blank to skip.
# Admin login email:    admin@foodhub.local
# Customer login email: customer@foodhub.local
SEED_ADMIN_PASSWORD=Admin12345
SEED_CUSTOMER_PASSWORD=Customer12345
